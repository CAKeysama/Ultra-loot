  "bugs": [
    {
      "id": "BUG-01",
      "status": "fixed",
      "location": "machine/SideConfiguration#fromArray",
      "description": "Out-of-range persisted side ordinal became NONE instead of the family default"
    },
    {
      "id": "BUG-02",
      "status": "fixed",
      "location": "upgrade/UpgradeModifiers#energyPerOperation",
      "description": "Math.ceil on floating-point noise added 1 FE to exact costs (881 instead of 880)"
    },
    {
      "id": "BUG-03",
      "status": "fixed",
      "location": "machine/AbstractMachineBlockEntity#tickOperation, MobLootGeneratorBlockEntity#checkCanOperate",
      "description": "Cost per operation above the FE buffer / XP tank showed NO_ENERGY / NO_XP forever (could never be paid)"
    }
  ],
